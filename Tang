-- ESP.
---Create ESP objects for an entity.
local function createEsp(model)
	local entry = {}
	entry.highlight = new("Highlight", { DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false }, espGui)

	if hasDrawing then
		pcall(function()
			entry.box = Drawing.new("Square")
			entry.box.Thickness = 1
			entry.box.Filled = false

			entry.name = Drawing.new("Text")
			entry.name.Size = 14
			entry.name.Center = true
			entry.name.Outline = true

			entry.health = Drawing.new("Line")
			entry.health.Thickness = 2

			entry.tracer = Drawing.new("Line")
			entry.tracer.Thickness = 1
		end)
	end

	TangHub.espEntries[model] = entry
end

---Remove ESP objects of an entity.
local function removeEsp(model)
	local entry = TangHub.espEntries[model]
	if not entry then return end

	entry.highlight:Destroy()
	for _, key in ipairs(DRAWING_KEYS) do
		if entry[key] then pcall(function() entry[key]:Remove() end) end
	end
	TangHub.espEntries[model] = nil
end

---Hide only the Drawing objects of an entry.
local function hideDrawings(entry)
	for _, key in ipairs(DRAWING_KEYS) do
		if entry[key] then entry[key].Visible = false end
	end
end

---Update ESP of an entity.
local function updateEsp(model, entry)
	local humanoid, hrp = getValidParts(model)
	if not settings.esp or not hrp then
		entry.highlight.Enabled = false
		hideDrawings(entry)
		return
	end

	local color = settings.espColor

	entry.highlight.Adornee = model
	entry.highlight.FillColor = color
	entry.highlight.OutlineColor = color
	entry.highlight.FillTransparency = 1 - settings.espOpacity / 100
	entry.highlight.Enabled = settings.espBox

	if not entry.box then return end

	local rootPos, onScreen = currentCamera:WorldToViewportPoint(hrp.Position)
	if not onScreen then
		hideDrawings(entry)
		return
	end

	local topPos = currentCamera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.8, 0))
	local bottomPos = currentCamera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
	local height = math.abs(bottomPos.Y - topPos.Y)
	local width = height / 2

	entry.box.Visible = settings.espBox
	entry.box.Color = color
	entry.box.Size = Vector2.new(width, height)
	entry.box.Position = Vector2.new(rootPos.X - width / 2, topPos.Y)

	local distance = math.floor((hrp.Position - currentCamera.CFrame.Position).Magnitude)
	local displayName = isBot(model) and ("[BOT] " .. model.Name:sub(1, -6)) or model.Name
	entry.name.Visible = settings.espName
	entry.name.Color = color
	entry.name.Text = displayName .. " [" .. distance .. "m]"
	entry.name.Position = Vector2.new(rootPos.X, topPos.Y - 16)

	local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
	entry.health.Visible = settings.espHealth
	entry.health.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), ratio)
	entry.health.From = Vector2.new(rootPos.X - width / 2 - 4, topPos.Y + height)
	entry.health.To = Vector2.new(rootPos.X - width / 2 - 4, topPos.Y + height - height * ratio)

	local viewport = currentCamera.ViewportSize
	entry.tracer.Visible = settings.espTracer
	entry.tracer.Color = color
	entry.tracer.From = Vector2.new(viewport.X / 2, viewport.Y)
	entry.tracer.To = Vector2.new(rootPos.X, rootPos.Y)
end

---Create missing ESP entries and drop stale ones.
local function syncEsp()
	local alive = {}
	for _, model in ipairs(getEntities()) do
		alive[model] = true
		if not TangHub.espEntries[model] then createEsp(model) end
	end
	for model in pairs(TangHub.espEntries) do
		if not alive[model] or not model.Parent then removeEsp(model) end
	end
end

-- Main loop.
local lastSync = 0
table.insert(TangHub.connections, runService.RenderStepped:Connect(function()
	currentCamera = workspace.CurrentCamera

	if fovCircle then
		fovCircle.Visible = settings.showFov
		fovCircle.Radius = settings.fovRadius
		fovCircle.Position = userInputService:GetMouseLocation()
	end

	if os.clock() - lastSync > 0.5 then
		lastSync = os.clock()
		pcall(syncEsp)
	end

	local ok, part = pcall(function()
		if settings.silentAim or settings.cameraLock then
			return getAimPart()
		end
	end)
	currentTarget = ok and part or nil

	-- Camera lock (extra aim assist).
	if settings.cameraLock and currentTarget then
		local allowed = not settings.lockNeedsRmb or userInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		if allowed then
			local goal = CFrame.lookAt(currentCamera.CFrame.Position, currentTarget.Position)
			currentCamera.CFrame = currentCamera.CFrame:Lerp(goal, 1 / math.max(settings.smoothness, 1))
		end
	end

	for model, entry in pairs(TangHub.espEntries) do
		local espOk, espError = pcall(updateEsp, model, entry)
		if not espOk and not espErrorLogged then
			espErrorLogged = true
			log("ESP error: " .. tostring(espError))
		end
	end
end))

-- Movement.
table.insert(TangHub.connections, runService.Stepped:Connect(function()
	local character = getLocalEntity()
	if not character then return end

	if settings.noclip then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and settings.speedHack then
		humanoid.WalkSpeed = settings.walkSpeed
	end
end))

table.insert(TangHub.connections, userInputService.JumpRequest:Connect(function()
	if not settings.infJump then return end

	local character = getLocalEntity()
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
end))

---Clean everything up.
function TangHub.detach()
	settings.silentAim = false
	settings.cameraLock = false
	for _, restore in pairs(TangHub.restore) do
		pcall(restore)
	end
	for _, connection in ipairs(TangHub.connections) do
		pcall(function() connection:Disconnect() end)
	end
	for model in pairs(TangHub.espEntries) do
		pcall(removeEsp, model)
	end
	if fovCircle then pcall(function() fovCircle:Remove() end) end
	espGui:Destroy()
	env.TangHub = nil
end

