---Print to the console and the fallback status bar.
local function log(text)
	warn("[TangHub] " .. text)
	if statusLabel then
		statusLabel.Text = "  " .. text
	end
end

---Create an instance with properties.
local function new(class, props, parent)
	local instance = Instance.new(class)
	for key, value in pairs(props) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

---Create a ScreenGui in a hidden container.
local function createGui(name)
	local gui = new("ScreenGui", { Name = name, ResetOnSpawn = false, DisplayOrder = 999 })
	local ok = pcall(function()
		if protect_gui then pcall(protect_gui, gui) end
		gui.Parent = (gethui and gethui()) or coreGui
	end)
	if not ok or not gui.Parent then
		gui.Parent = localPlayer:WaitForChild("PlayerGui")
	end
	return gui
end

