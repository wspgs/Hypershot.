---Advance a setting to the next cycle value.
local function advanceCycle(item)
	local key, values = item[3], item[6]
	local index = 1
	for position, value in ipairs(values) do
		if settings[key] == value then
			index = position % #values + 1
			break
		end
	end
	settings[key] = values[index]
	log(item[2] .. " = " .. tostring(settings[key]))
end

---Advance the ESP color preset.
local function advanceColor()
	local index = 1
	for position, color in ipairs(COLOR_PRESETS) do
		if settings.espColor == color then
			index = position % #COLOR_PRESETS + 1
			break
		end
	end
	settings.espColor = COLOR_PRESETS[index]
	log("เปลี่ยนสี ESP เป็นตัวที่ " .. index)
end

---Build the ByteUI menu.
---@param Library table
local function buildByteUi(Library)
	local window = Library.new({ Title = "Tang Hub" })

	for _, tabSpec in ipairs(MENU) do
		local tab = window:addTab({ Name = tabSpec.name })

		for _, item in ipairs(tabSpec.items) do
			local kind, name, key = item[1], item[2], item[3]

			local ok, err = pcall(function()
				if kind == "toggle" then
					tab:addToggle({ Name = name, Default = settings[key], Callback = function(state) settings[key] = state end })
				elseif kind == "slider" then
					tab:addSlider({
						Name = name, Min = item[4], Max = item[5], Default = settings[key], Increment = 1,
						Callback = function(value) settings[key] = value end,
					})
				elseif kind == "color" then
					local options = { Name = name, Default = settings[key], Callback = function(color) settings[key] = color end }
					if tab.addColorpicker then
						tab:addColorpicker(options)
					else
						tab:addColorPicker(options)
					end
				elseif kind == "keybind" then
					tab:addKeybind({ Name = name, Default = item[4], Callback = ACTIONS[key] })
				elseif kind == "button" then
					tab:addButton({ Name = name, Callback = ACTIONS[key] })
				end
			end)

			if not ok then
				warn("[TangHub] UI element failed: " .. name .. " | " .. tostring(err))
			end
		end
	end

	window:addSettings()
	window:addCredits("Tang Hub")
end

---Build a basic built-in menu when ByteUI cannot load.
local function buildFallbackUi()
	local gui = createGui("TangHubMenu")
	table.insert(TangHub.connections, { Disconnect = function() gui:Destroy() end })

	local main = new("Frame", {
		Size = UDim2.fromOffset(330, 420), Position = UDim2.fromOffset(30, 80),
		BackgroundColor3 = Color3.fromRGB(22, 22, 30), BorderSizePixel = 0,
	}, gui)
	new("UICorner", { CornerRadius = UDim.new(0, 10) }, main)

	local title = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Color3.fromRGB(124, 77, 255), Text = "TANG HUB  (ลากเพื่อย้าย)",
		TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.SourceSansBold, TextSize = 18,
	}, main)
	new("UICorner", { CornerRadius = UDim.new(0, 10) }, title)

	local dragging, dragStart, startPos = false, nil, nil
	title.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, dragStart, startPos = true, input.Position, main.Position
		end
	end)
	table.insert(TangHub.connections, userInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end))
	table.insert(TangHub.connections, userInputService.InputEnded:Connect(function() dragging = false end))

	local list = new("ScrollingFrame", {
		Size = UDim2.new(1, -12, 1, -66), Position = UDim2.fromOffset(6, 40), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
	}, main)
	new("UIListLayout", { Padding = UDim.new(0, 5) }, list)

	statusLabel = new("TextLabel", {
		Size = UDim2.new(1, -12, 0, 20), Position = UDim2.new(0, 6, 1, -24), BackgroundTransparency = 1, Text = "",
		TextColor3 = Color3.fromRGB(150, 150, 170), Font = Enum.Font.SourceSans, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
	}, main)

	local function addRow(text, callback)
		local button = new("TextButton", {
			Size = UDim2.new(1, -6, 0, 30), BackgroundColor3 = Color3.fromRGB(40, 40, 55), Text = text,
			TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.SourceSansBold, TextSize = 16,
		}, list)
		new("UICorner", { CornerRadius = UDim.new(0, 6) }, button)
		button.MouseButton1Click:Connect(function() callback(button) end)
		return button
	end

	for _, tabSpec in ipairs(MENU) do
		new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Text = "— " .. tabSpec.name .. " —",
			TextColor3 = Color3.fromRGB(160, 120, 255), Font = Enum.Font.SourceSansBold, TextSize = 16,
		}, list)

		for _, item in ipairs(tabSpec.items) do
			local kind, name, key = item[1], item[2], item[3]

			if kind == "toggle" then
				local function refresh(button)
					button.Text = name .. (settings[key] and "  :  เปิด" or "  :  ปิด")
					button.BackgroundColor3 = settings[key] and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(40, 40, 55)
				end
				local row = addRow("", function(button)
					settings[key] = not settings[key]
					refresh(button)
				end)
				refresh(row)
			elseif kind == "slider" then
				local row = addRow("", function(button)
					advanceCycle(item)
					button.Text = name .. "  :  " .. settings[key]
				end)
				row.Text = name .. "  :  " .. settings[key]
			elseif kind == "color" then
				local row = addRow(name .. "  (กดเพื่อเปลี่ยนสี)", function(button)
					advanceColor()
					button.TextColor3 = settings.espColor
				end)
				row.TextColor3 = settings.espColor
			elseif kind == "button" or kind == "keybind" then
				addRow(name, ACTIONS[key])
			end
		end
	end

	table.insert(TangHub.connections, userInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.RightShift then
			main.Visible = not main.Visible
		elseif input.KeyCode == Enum.KeyCode.X then
			ACTIONS.toggleSilent()
		end
	end))
end

---Download the ByteUI source, or read it from the workspace file.
---@return string
local function fetchLibrarySource()
	local ok, response = pcall(request, { Url = UI_URL, Method = "GET" })
	if ok and response and response.Success and response.Body and #response.Body > 0 then
		return response.Body
	end

	if isfile and isfile("ByteUI.lua") then
		return readfile("ByteUI.lua")
	end

	error("โหลด ByteUI ไม่สำเร็จ (UI_URL ผิด หรือไม่มีไฟล์ ByteUI.lua ใน workspace)")
end

-- Start the UI.
local uiOk, uiError = pcall(function()
	local chunk, compileError = loadstring(fetchLibrarySource())
	assert(chunk, "ไฟล์ ByteUI คอมไพล์ไม่ผ่าน: " .. tostring(compileError))
	buildByteUi(chunk())
end)

if not uiOk then
	warn("[TangHub] ByteUI: " .. tostring(uiError))
	buildFallbackUi()
end

log((uiOk and "ByteUI พร้อม" or "ใช้เมนูสำรอง") .. (silentOk and " | Silent Aim พร้อม" or " | Silent Aim ไม่รองรับ") .. " | Team: " .. (globalStuff and "GlobalStuff" or "Player.Team") .. " | Drawing: " .. tostring(hasDrawing))
if not silentOk then warn("[TangHub] silent aim: " .. tostring(silentError)) end
