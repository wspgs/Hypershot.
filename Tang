-- Load the game's GlobalStuff module for team checks.
pcall(function()
	local modulesFolder = replicatedStorage:WaitForChild("Modules", 5)
	local moduleScript = modulesFolder and modulesFolder:WaitForChild("GlobalStuff", 5)
	if not moduleScript then return end

	if setthreadidentity then pcall(setthreadidentity, 2) end
	local loaded, module = pcall(require, moduleScript)
	if setthreadidentity then pcall(setthreadidentity, 8) end

	if loaded and type(module) == "table" then
		globalStuff = module
	end
end)

-- Entity helpers (this game keeps characters in Workspace.Entities).
---Return the local player's entity model.
local function getLocalEntity()
	local folder = workspace:FindFirstChild("Entities")
	return (folder and folder:FindFirstChild(localPlayer.Name)) or localPlayer.Character
end

---Check whether a model is a bot.
local function isBot(model)
	return model.Name:sub(-5) == "__Bot"
end

---Check whether a model is on our team.
local function isFriendly(model)
	local localEntity = getLocalEntity()

	if globalStuff and globalStuff.SameTeam and localEntity then
		local ok, same = pcall(globalStuff.SameTeam, globalStuff, localEntity, model)
		if ok then return same == true end
	end

	local player = playersService:FindFirstChild(model.Name)
	return player ~= nil and player.Team ~= nil and player.Team == localPlayer.Team
end

---Return every other entity model.
local function getEntities()
	local result = {}
	local folder = workspace:FindFirstChild("Entities")

	if folder then
		for _, model in ipairs(folder:GetChildren()) do
			if model:IsA("Model") and model.Name ~= localPlayer.Name then
				table.insert(result, model)
			end
		end
		return result
	end

	for _, player in ipairs(playersService:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			table.insert(result, player.Character)
		end
	end
	return result
end

---Return humanoid and root part if the entity is a valid target.
local function getValidParts(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not (humanoid and hrp and humanoid.Health > 0) then return end

	local bot = isBot(model)
	if bot and not settings.targetBots then return end
	if not bot and not settings.targetPlayers then return end

	if settings.teamCheck and isFriendly(model) then return end

	return humanoid, hrp
end

---Check line of sight from the camera to a part (ignores entities like the game does).
local function isVisible(part)
	local exclude = {}
	for _, name in ipairs({ "IgnoreThese", "Entities", "EntityFocus", "StaticTargets" }) do
		local folder = workspace:FindFirstChild(name)
		if folder then table.insert(exclude, folder) end
	end
	if localPlayer.Character then table.insert(exclude, localPlayer.Character) end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = exclude

	local origin = currentCamera.CFrame.Position
	return workspace:Raycast(origin, part.Position - origin, params) == nil
end

---Return the entity whose HumanoidRootPart projects closest to the cursor
---within the FOV radius.
local function getClosestEntity()
	local closest, closestDist, candidates = nil, math.huge, {}
	local mousePos = userInputService:GetMouseLocation()

	for _, model in ipairs(getEntities()) do
		local humanoid, hrp = getValidParts(model)
		if hrp then
			local screenPos, onScreen = currentCamera:WorldToViewportPoint(hrp.Position)
			if onScreen then
				local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mousePos.X, mousePos.Y)).Magnitude
				if dist <= settings.fovRadius then
					table.insert(candidates, { model = model, dist = dist, screenPos = screenPos })
				end
			end
		end
	end

	for _, info in ipairs(candidates) do
		if info.dist < closestDist then
			closest = info.model
			closestDist = info.dist
		end
	end

	return closest, closestDist, candidates
end

---Pick the part to aim at.
local function getAimPart()
	local model = getClosestEntity()
	if not model then return end

	local partName = settings.aimHead and "Head" or "HumanoidRootPart"
	local part = model:FindFirstChild(partName) or model:FindFirstChild("HumanoidRootPart")
	if not part then return end

	if settings.wallCheck and not isVisible(part) then return end
	return part
end

-- Silent aim: redirect the aim direction inside the game's ShotClient module.
local silentOk, silentError = pcall(function()
	local entityFolder = replicatedStorage:WaitForChild("Entity", 5)
	local shotModule = entityFolder and entityFolder:WaitForChild("ShotClient", 5)
	assert(shotModule, "ShotClient not found")

	-- Drop identity so the module cannot see executor globals.
	if setthreadidentity then pcall(setthreadidentity, 2) end
	local loaded, ShotClient = pcall(require, shotModule)
	if setthreadidentity then pcall(setthreadidentity, 8) end
	assert(loaded and type(ShotClient) == "table", "require ShotClient failed")

	if isreadonly and isreadonly(ShotClient) then setreadonly(ShotClient, false) end

	local originalPrepare = ShotClient.Prepare
	local originalAimDirection = ShotClient.AimDirection
	assert(type(originalPrepare) == "function" and type(originalAimDirection) == "function", "unexpected ShotClient shape")

	ShotClient.Prepare = function(self, weapon, direction, flags)
		if settings.silentAim and currentTarget and not (flags and bit32.band(flags, MELEE_FLAG) ~= 0) then
			local origin = ShotClient:Origin()
			if origin then
				direction = (currentTarget.Position - origin).Unit
			end
		end
		return originalPrepare(self, weapon, direction, flags)
	end

	ShotClient.AimDirection = function(self, origin, ...)
		if settings.silentAim and currentTarget and typeof(origin) == "Vector3" then
			return (currentTarget.Position - origin).Unit
		end
		return originalAimDirection(self, origin, ...)
	end

	TangHub.restore.shotClient = function()
		ShotClient.Prepare = originalPrepare
		ShotClient.AimDirection = originalAimDirection
	end
end)

